{
  "about": "An agent's change made to what the editor shows now (agent.EditorChange.MadeTo; the web's madeTo). want null: the op no longer fits. cursor: code points into now's content, null for none. Every client's change has an op.",
  "cases": [
    {
      "name": "the editor still shows before: after, whatever the op",
      "before": {
        "title": "T",
        "content": "Milk\n"
      },
      "after": {
        "title": "T",
        "content": "Milk\n\n#tag\n"
      },
      "op": {
        "kind": "insert",
        "at": "end",
        "text": "#tag"
      },
      "now": {
        "title": "T",
        "content": "Milk\n"
      },
      "cursor": null,
      "want": {
        "title": "T",
        "content": "Milk\n\n#tag\n"
      }
    },
    {
      "name": "the editor still shows before: after, even for the whole content",
      "before": {
        "title": "T",
        "content": "Milk\n"
      },
      "after": {
        "title": "T",
        "content": "Milk\n\n#tag\n"
      },
      "op": {
        "kind": "content",
        "text": "Rewritten\n"
      },
      "now": {
        "title": "T",
        "content": "Milk\n"
      },
      "cursor": null,
      "want": {
        "title": "T",
        "content": "Milk\n\n#tag\n"
      }
    },
