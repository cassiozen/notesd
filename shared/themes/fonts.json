  "title": {
    "instrument-serif": {
      "family": "instrument-serif",
      "description": "A narrow display serif, the one the size rules were written for.",
      "weight": 400,
      "style": "normal",
      "axes": {},
      "scale": 1,
      "tracking": 0,
      "quote": {"weight": 400, "style": "italic"}
    },
    "shippori-mincho": {
      "family": "shippori-mincho",
      "description": "The Latin of a Japanese Mincho: calm, sharp-wedged serifs. It has no italic, so quotes stay roman, as Japanese typesetting sets them, rather than a slanted fake.",
      "weight": 500,
      "style": "normal",
      "axes": {},
      "scale": 0.9,
      "tracking": 0,
      "quote": {"weight": 400, "style": "normal"}
    },
    "playfair": {
      "family": "playfair",
      "description": "Playfair 2, narrowed: a Didone with optical sizes, so each size gets its own cut. Titles get full black-and-white contrast; small headings get sturdier strokes that hold on a screen's pixels.",
      "weight": 400,
      "style": "normal",
      "axes": {"wdth": 88},
      "scale": 1,
      "tracking": 0,
      "quote": {"weight": 400, "style": "italic"}
    },
    "nunito-sans-bold": {
      "family": "nunito-sans",
      "description": "The text face at its boldest weight, so headings and text read as one voice, as in a writing app whose headings are only bigger, bolder text.",
      "weight": 750,
      "style": "normal",
      "axes": {},
      "scale": 0.84,
      "tracking": -0.012,
      "quote": {"weight": 400, "style": "italic"}
    }
  },
  "body": {
    "instrument-sans": {"family": "instrument-sans"},
    "zen-kaku-gothic": {
      "family": "zen-kaku-gothic-new",
      "description": "The Latin of a Japanese gothic: plain, even, a little wider-set than Western grotesques. No italic."
    },
    "hanken-grotesk": {"family": "hanken-grotesk"},
    "nunito-sans": {"family": "nunito-sans"}
