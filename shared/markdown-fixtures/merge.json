{
  "description": "Three-way merge of note bodies (architecture §6.2). Every platform's merge must turn `base`, `mine` and `theirs` into exactly `expect`: {\"clean\": markdown}, {\"partial\": {\"theirs\", \"mine\"}} (each side's version of the blocks both changed, with every change that merged), or \"conflict\".",
  "cases": [
    {"name": "different paragraphs", "base": "One\n\nTwo\n\nThree\n", "mine": "One!\n\nTwo\n\nThree\n", "theirs": "One\n\nTwo\n\nThree!\n", "expect": {"clean": "One!\n\nTwo\n\nThree!\n"}},
    {"name": "adjacent paragraphs", "base": "One\n\nTwo\n", "mine": "One!\n\nTwo\n", "theirs": "One\n\nTwo!\n", "expect": {"clean": "One!\n\nTwo!\n"}},
    {"name": "same paragraph", "base": "Plan for Tuesday\n", "mine": "Plan for Wednesday\n", "theirs": "Plan for Thursday\n", "expect": "conflict"},
    {"name": "same paragraph among others", "base": "Intro\n\nPlan for Tuesday\n\nOutro\n", "mine": "Intro, edited\n\nPlan for Wednesday\n\nOutro\n", "theirs": "Intro\n\nPlan for Thursday\n\nOutro, edited\n", "expect": {"partial": {"theirs": "Intro, edited\n\nPlan for Thursday\n\nOutro, edited\n", "mine": "Intro, edited\n\nPlan for Wednesday\n\nOutro, edited\n"}}},
    {"name": "same change on both sides", "base": "A\n\nB\n", "mine": "A\n\nB!\n", "theirs": "A\n\nB!\n", "expect": {"clean": "A\n\nB!\n"}},
    {"name": "checkbox vs item text", "base": "- [ ] milk\n- [ ] eggs\n", "mine": "- [x] milk\n- [ ] eggs\n", "theirs": "- [ ] oat milk\n- [ ] eggs\n", "expect": {"clean": "- [x] oat milk\n- [ ] eggs\n"}},
    {"name": "checkbox ticked on both sides", "base": "- [ ] milk\n", "mine": "- [x] milk\n", "theirs": "- [x] milk\n", "expect": {"clean": "- [x] milk\n"}},
    {"name": "tick one item, add another", "base": "- [ ] milk\n- [ ] eggs\n", "mine": "- [x] milk\n- [ ] eggs\n", "theirs": "- [ ] milk\n- [ ] eggs\n- [ ] bread\n", "expect": {"clean": "- [x] milk\n- [ ] eggs\n- [ ] bread\n"}},
    {"name": "heading level vs heading text", "base": "## Plans\n\nText\n", "mine": "### Plans\n\nText\n", "theirs": "## Summer plans\n\nText\n", "expect": {"clean": "### Summer plans\n\nText\n"}},
    {"name": "heading level on both sides", "base": "## Plans\n", "mine": "# Plans\n", "theirs": "### Plans\n", "expect": "conflict"},
    {"name": "ordered list insert vs later edit", "base": "1. a\n2. b\n3. c\n4. d\n5. e\n6. f\n7. g\n8. h\n9. i\n10. j\n11. k\n12. l\n", "mine": "1. a\n2. new\n3. b\n4. c\n5. d\n6. e\n7. f\n8. g\n9. h\n10. i\n11. j\n12. k\n13. l\n", "theirs": "1. a\n2. b\n3. c\n4. d\n5. e\n6. f\n7. g\n8. h\n9. i\n10. j\n11. k\n12. l, edited\n", "expect": {"clean": "1. a\n2. new\n3. b\n4. c\n5. d\n6. e\n7. f\n8. g\n9. h\n10. i\n11. j\n12. k\n13. l, edited\n"}},
    {"name": "ordered list start vs item edit", "base": "1. a\n2. b\n", "mine": "3. a\n4. b\n", "theirs": "1. a\n2. b, edited\n", "expect": {"clean": "3. a\n4. b, edited\n"}},
    {"name": "both append to a checklist", "base": "- [ ] milk\n", "mine": "- [ ] milk\n- [ ] eggs\n", "theirs": "- [ ] milk\n- [ ] bread\n", "expect": "conflict"},
    {"name": "both append paragraphs", "base": "Day one\n", "mine": "Day one\n\nMine\n", "theirs": "Day one\n\nTheirs\n", "expect": "conflict"},
    {"name": "delete vs edit", "base": "Keep\n\nGone\n", "mine": "Keep\n", "theirs": "Keep\n\nGone, edited\n", "expect": "conflict"},
    {"name": "delete vs edit elsewhere", "base": "A\n\nB\n\nC\n", "mine": "A\n\nC\n", "theirs": "A\n\nB\n\nC!\n", "expect": {"clean": "A\n\nC!\n"}},
    {"name": "edit next to an insertion", "base": "P1\n\nP2\n", "mine": "P1!\n\nP2\n", "theirs": "P1\n\nNew\n\nP2\n", "expect": {"clean": "P1!\n\nNew\n\nP2\n"}},
    {"name": "move vs edit", "base": "P\n\nQ\n\nR\n", "mine": "Q\n\nR\n\nP\n", "theirs": "P\n\nQ!\n\nR\n", "expect": {"clean": "Q!\n\nR\n\nP\n"}},
    {"name": "move vs edit of the moved block", "base": "P\n\nQ\n\nR\n", "mine": "Q\n\nR\n\nP\n", "theirs": "P!\n\nQ\n\nR\n", "expect": {"partial": {"theirs": "P!\n\nQ\n\nR\n\nP\n", "mine": "Q\n\nR\n\nP\n"}}},
    {"name": "paragraph becomes a list vs text edit", "base": "milk\n\nNotes\n", "mine": "- milk\n\nNotes\n", "theirs": "oat milk\n\nNotes\n", "expect": "conflict"},
    {"name": "paragraph becomes a list vs edit elsewhere", "base": "milk\n\nNotes\n", "mine": "- milk\n\nNotes\n", "theirs": "milk\n\nNotes!\n", "expect": {"clean": "- milk\n\nNotes!\n"}},
    {"name": "edit inside a fence on both sides", "base": "```\ncode\n```\n", "mine": "```\ncode 1\n```\n", "theirs": "```\ncode 2\n```\n", "expect": "conflict"},
    {"name": "fence edit vs paragraph edit", "base": "Intro\n\n```\ncode\n```\n", "mine": "Intro\n\n```\ncode 1\n```\n", "theirs": "Intro!\n\n```\ncode\n```\n", "expect": {"clean": "Intro!\n\n```\ncode 1\n```\n"}},
    {"name": "nested list item edits", "base": "- a\n  - a1\n  - a2\n- b\n", "mine": "- a\n  - a1!\n  - a2\n- b\n", "theirs": "- a\n  - a1\n  - a2!\n- b\n", "expect": {"clean": "- a\n  - a1!\n  - a2!\n- b\n"}},
    {"name": "blockquote edits", "base": "> one\n>\n> two\n", "mine": "> one!\n>\n> two\n", "theirs": "> one\n>\n> two!\n", "expect": {"clean": "> one!\n>\n> two!\n"}},
    {"name": "list in a blockquote", "base": "> - a\n> - b\n", "mine": "> - a!\n> - b\n", "theirs": "> - a\n> - b!\n", "expect": {"clean": "> - a!\n> - b!\n"}},
    {"name": "both remove different items", "base": "- a\n- b\n", "mine": "- a\n", "theirs": "- b\n", "expect": "conflict"},
    {"name": "emoji and RTL", "base": "שלום 👋\n\nend\n", "mine": "שלום 👋🏽\n\nend\n", "theirs": "שלום 👋\n\nend 🎉\n", "expect": {"clean": "שלום 👋🏽\n\nend 🎉\n"}},
    {"name": "empty on one side", "base": "A\n", "mine": "", "theirs": "A\n\nB\n", "expect": {"clean": "B\n"}},
    {"name": "both emptied", "base": "A\n", "mine": "", "theirs": "", "expect": {"clean": ""}},
    {"name": "image paragraph vs text", "base": "![cat](notesd:image/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef?w=10&h=10)\n\nCaption\n", "mine": "![a cat](notesd:image/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef?w=10&h=10)\n\nCaption\n", "theirs": "![cat](notesd:image/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef?w=10&h=10)\n\nCaption!\n", "expect": {"clean": "![a cat](notesd:image/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef?w=10&h=10)\n\nCaption!\n"}},
    {"name": "tag lines", "base": "#work\n\nBody\n", "mine": "#work #urgent\n\nBody\n", "theirs": "#work\n\nBody, edited\n", "expect": {"clean": "#work #urgent\n\nBody, edited\n"}},
    {"name": "non canonical input", "base": "* a\n* b\n", "mine": "* a!\n* b\n", "theirs": "- a\n- b!\n", "expect": {"clean": "- a!\n- b!\n"}},
    {"name": "same item edited in nested task", "base": "- [ ] a\n  - [ ] sub\n", "mine": "- [x] a\n  - [ ] sub\n", "theirs": "- [ ] a\n  - [x] sub\n", "expect": {"clean": "- [x] a\n  - [x] sub\n"}},
    {"name": "adjacent lists stay apart", "base": "- a\n\nP\n\n- b\n", "mine": "- a\n\n* b\n", "theirs": "- a!\n\nP\n\n- b\n", "expect": {"clean": "- a!\n\n* b\n"}},
    {"name": "repeated lines", "base": "- [ ] x\n- [ ] x\n- [ ] y\n", "mine": "- [ ] x\n- [ ] x\n- [x] y\n", "theirs": "- [ ] x\n- [ ] x\n- [ ] x\n- [ ] y\n", "expect": {"clean": "- [ ] x\n- [ ] x\n- [ ] x\n- [x] y\n"}},
    {"name": "same block added in two places", "base": "A\n", "mine": "X\n\nA\n", "theirs": "A\n\nX\n", "expect": "conflict"}
  ]
}
