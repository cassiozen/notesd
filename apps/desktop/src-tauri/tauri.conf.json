{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "notesd",
  "version": "0.1.0",
  "identifier": "app.notesd.desktop",
  "build": {
    "frontendDist": "../setup"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "public.app-category.productivity",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
