// Settings shared by every target. Signing lives in Local.xcconfig (gitignored):
// copy Local.xcconfig.example and fill in your team.

IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
ENABLE_USER_SCRIPT_SANDBOXING = YES
CODE_SIGN_STYLE = Automatic
// Fallbacks: Version.xcconfig (gitignored) overrides both with the version from `git describe`.
// It's written by scripts/version.sh, which the Notes scheme runs as a build pre-action, so
// Xcode and `mise run build:ios` / `test:ios` get it; run it by hand for other schemes.
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 1
#include? "Version.xcconfig"

// A bundle ID must be unique per Apple ID, so the prefix is yours.
BUNDLE_ID_PREFIX = dev.notesd.local
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
