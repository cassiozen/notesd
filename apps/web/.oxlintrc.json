{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "oxc",
    "unicorn",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "warn",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ]
  },
  "env": {
    "browser": true
  },
  "overrides": [
    {
      "files": [
        "test/**",
        "e2e/**"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      // Worker and BroadcastChannel postMessage take no target origin; the rule only knows window's.
      // Their loops are retries and the sync schedule, sequential on purpose.
      "files": [
        "src/offline/**"
      ],
      "rules": {
        "unicorn/require-post-message-target-origin": "off",
        "no-await-in-loop": "off"
      }
    }
  ]
}
